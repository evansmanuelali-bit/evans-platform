# ----- OBRIGATORIO -----
# Connection string do PostgreSQL (Render Postgres ou Supabase Postgres)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Use "true" ao conectar em Postgres hospedado (Render/Supabase usam SSL)
PGSSL=true

# ----- OPCIONAL -----
NODE_ENV=development
PORT=4000
# Dias para a sessao permanecer valida (lembre-se: sem armazenar senha)
SESSION_DAYS=7
# Credenciais do administrador (usadas apenas para criar o admin na primeira vez)
ADMIN_NAME=admin
ADMIN_PASSWORD=evans@xz
# Tamanho maximo de upload de imagem (MB)
MAX_UPLOAD_MB=5
